@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <div class="recent-section">
        <h1>Dashboard</h1>
        <p class="text-muted">Prijavljeni korisnici se automatski preusmjeravaju na svoj dashboard, a admini na admin dashboard.</p>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            if (User.IsInRole("Admin"))
            {
                <a asp-controller="Home" asp-action="AdminDashboard" class="btn btn-primary">Admin dashboard</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="UserDashboard" class="btn btn-primary">Moj dashboard</a>
            }
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Prijava</a>
        }
    </div>
</div>
