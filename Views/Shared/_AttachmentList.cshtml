@model List<Attachment>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Datoteka</th>
            <th>Veličina</th>
            <th>Datum</th>
            <th>Akcija</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted text-center">Nema uploadanih datoteka</td>
            </tr>
        }
        else
        {
            @foreach (var attachment in Model)
            {
                <tr>
                    <td>
                        <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                    </td>
                    <td>@attachment.FileSize</td>
                    <td>@attachment.UploadedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="deleteAttachment(@attachment.Id)">
                            Obriši
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
