@{
    // DateTime Picker Partial View
    // Korištenje: @Html.PartialAsync("_DateTimePickerPartial", new { propertyName = "CompletedDate", label = "Datum Dovršetka" })
    var propertyName = ViewData["propertyName"]?.ToString() ?? "DateTime";
    var label = ViewData["label"]?.ToString() ?? "Odaberi Datum i Vrijeme";
    var placeholder = ViewData["placeholder"]?.ToString() ?? "dd.MM.yyyy HH:mm";
}

<div class="form-group mb-3">
    <label for="@propertyName" class="form-label">📅 @label</label>
    <div class="input-group">
        <input type="text" 
               id="@propertyName-display" 
               class="form-control datetimepicker-display" 
               placeholder="@placeholder" 
               readonly
               style="cursor: pointer; background-color: #f8f9fa;">
        <span class="input-group-text" style="cursor: pointer;" onclick="showDateTimePicker('@propertyName')">
            <i class="fas fa-calendar-alt">📅</i>
        </span>
    </div>
    <input type="hidden" id="@propertyName" name="@propertyName" />
    <small class="form-text text-muted">Format: dd.MM.yyyy HH:mm</small>
</div>

<style>
    .datetime-picker-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .datetime-picker-content {
        background-color: white;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        border-radius: 8px;
        width: 300px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .datetime-picker-header {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 15px;
        color: #333;
    }

    .datetime-picker-input {
        width: 100%;
        padding: 8px;
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .datetime-picker-button {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .datetime-picker-button-ok {
        background-color: #28a745;
        color: white;
        margin-bottom: 5px;
    }

    .datetime-picker-button-ok:hover {
        background-color: #218838;
    }

    .datetime-picker-button-cancel {
        background-color: #6c757d;
        color: white;
    }

    .datetime-picker-button-cancel:hover {
        background-color: #5a6268;
    }

    .datetime-picker-button-now {
        background-color: #007bff;
        color: white;
        margin-bottom: 5px;
    }

    .datetime-picker-button-now:hover {
        background-color: #0056b3;
    }
</style>

<script type="text/javascript">
    function showDateTimePicker(propertyName) {
        // Kreiraj modal ako ne postoji
        let modal = document.getElementById(propertyName + '-modal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = propertyName + '-modal';
            modal.className = 'datetime-picker-modal';
            
            // Dohvati trenutnu vrijednost
            const currentInput = document.getElementById(propertyName);
            let currentDate = new Date();
            
            if (currentInput && currentInput.value) {
                // Pokušaj parsirati date
                const dateParts = currentInput.value.split('T');
                if (dateParts.length === 2) {
                    const [year, month, day] = dateParts[0].split('-');
                    const [hour, minute] = dateParts[1].split(':');
                    currentDate = new Date(year, month - 1, day, hour || 0, minute || 0);
                }
            }

            const dateStr = currentDate.toISOString().slice(0, 10);
            const timeStr = String(currentDate.getHours()).padStart(2, '0') + ':' + String(currentDate.getMinutes()).padStart(2, '0');

            modal.innerHTML = `
                <div class="datetime-picker-content">
                    <div class="datetime-picker-header">Odaberi Datum i Vrijeme</div>
                    <input type="date" id="${propertyName}-date" class="datetime-picker-input" value="${dateStr}" />
                    <input type="time" id="${propertyName}-time" class="datetime-picker-input" value="${timeStr}" />
                    
                    <button type="button" class="datetime-picker-button datetime-picker-button-now" onclick="setDateTimeNow('${propertyName}')">
                        🕐 Trenutno vrijeme
                    </button>
                    
                    <button type="button" class="datetime-picker-button datetime-picker-button-ok" onclick="confirmDateTime('${propertyName}')">
                        ✅ Potvrdi
                    </button>
                    
                    <button type="button" class="datetime-picker-button datetime-picker-button-cancel" onclick="closeDateTimePicker('${propertyName}')">
                        ❌ Otkaži
                    </button>
                </div>
            `;
            
            document.body.appendChild(modal);
        }

        document.getElementById(propertyName + '-modal').style.display = 'block';
    }

    function setDateTimeNow(propertyName) {
        const now = new Date();
        const dateStr = now.toISOString().slice(0, 10);
        const timeStr = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        
        document.getElementById(propertyName + '-date').value = dateStr;
        document.getElementById(propertyName + '-time').value = timeStr;
    }

    function confirmDateTime(propertyName) {
        const dateInput = document.getElementById(propertyName + '-date');
        const timeInput = document.getElementById(propertyName + '-time');
        const hiddenInput = document.getElementById(propertyName);
        const displayInput = document.getElementById(propertyName + '-display');

        if (dateInput.value && timeInput.value) {
            // Format za skriveni input: yyyy-MM-ddTHH:mm (ISO 8601)
            const isoValue = dateInput.value + 'T' + timeInput.value;
            hiddenInput.value = isoValue;

            // Format za prikaz: dd.MM.yyyy HH:mm (HR format)
            const [year, month, day] = dateInput.value.split('-');
            const displayValue = day + '.' + month + '.' + year + ' ' + timeInput.value;
            displayInput.value = displayValue;

            // Trigger change event
            const event = new Event('change', { bubbles: true });
            hiddenInput.dispatchEvent(event);

            closeDateTimePicker(propertyName);
        } else {
            alert('Molimo odaberi datum i vrijeme');
        }
    }

    function closeDateTimePicker(propertyName) {
        const modal = document.getElementById(propertyName + '-modal');
        if (modal) {
            modal.style.display = 'none';
        }
    }

    // Zatvori modal pri kliku izvan
    $(document).on('click', function(e) {
        if ($(e.target).hasClass('datetime-picker-modal')) {
            $(e.target).hide();
        }
    });
</script>
