@model User

@{
    ViewData["Title"] = $"Uredi Korisnika - {Model.Username}";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1>✏️ Uredi Korisnika</h1>
            <p class="text-muted">Ažuriraj podatke korisnika</p>

            <form asp-action="Edit" asp-controller="User" asp-route-id="@Model.Id" method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">👤 Korisničko Ime</label>
                    <input asp-for="Username" class="form-control" placeholder="npr. ivan_fitness" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">📧 Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="npr. ivan@example.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Bio" class="form-label">📝 Biografija</label>
                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Ispričaj nešto o sebi..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Level" class="form-label">⭐ Nivo</label>
                    <input asp-for="Level" class="form-control" type="number" min="1" max="100" />
                    <span asp-validation-for="Level" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PreferredMeditationType" class="form-label">🧘 Preferirana Meditacija</label>
                    <select asp-for="PreferredMeditationType" class="form-control">
                        <option value="Guided">🎧 Vođena Meditacija</option>
                        <option value="Breathing">💨 Disanje</option>
                        <option value="Mantras">🔮 Mantras</option>
                        <option value="Mindfulness">🌿 Svjesnost</option>
                        <option value="Visualization">🎨 Vizualizacija</option>
                    </select>
                </div>

                <div class="alert alert-info">
                    <small>💎 Ukupni XP: <strong>@Model.TotalXP</strong> | Član od: <strong>@Model.CreatedDate.ToString("dd.MM.yyyy")</strong></small>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">✅ Spremi Promjene</button>
                    <a asp-action="Details" asp-controller="User" asp-route-id="@Model.Id" class="btn btn-secondary">← Natrag na profil</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
